#import <Foundation/Foundation.h>
#import <CoreVideo/CoreVideo.h>

NS_ASSUME_NONNULL_BEGIN

@interface DetectEngine : NSObject

- (BOOL)initEngine;
- (NSArray *)detectFaces:(CVPixelBufferRef)pixelBuffer;

@end

NS_ASSUME_NONNULL_END
