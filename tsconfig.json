{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "types": ["react"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "example",
    "example/**/*",
    "android",
    "ios",
    "lib",
    "node_modules"
  ]
}
