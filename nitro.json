{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["arcsoftfacern"],
  "ios": {
    "iosModuleName": "ArcSoftFaceReactNative"
  },
  "android": {
    "androidNamespace": ["arcsoftfacern"],
    "androidCxxLibName": "ArcsoftFaceReactNative"
  },
  "autolinking": {
    "ArcsoftFrameDetector": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridArcsoftFrameDetector"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridArcsoftFrameDetector"
      }
    }
  },
  "ignorePaths": ["**/node_modules", "example", "lib"]
}
